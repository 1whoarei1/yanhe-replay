{
  "manifest_version": 3,
  "name": "延河回放助手",
  "version": "0.5.0",
  "description": "延河课堂全校课程搜索、回放与直播，支持双画面、视频下载、歌词字幕与时间校准。",
  "minimum_chrome_version": "120",
  "permissions": [
    "cookies",
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://*.yanhekt.cn/*",
    "https://yanhe.bit.edu.cn/*",
    "https://share.ruc.edu.kg/*"
  ],
  "action": {
    "default_title": "打开延河回放助手",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://aita.yanhekt.cn/*",
        "https://www.yanhekt.cn/*"
      ],
      "js": [
        "auth-content.js",
        "launcher.js"
      ],
      "css": [
        "launcher.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https://share.ruc.edu.kg https://*.yanhekt.cn; media-src 'self' blob: https://*.yanhekt.cn; img-src 'self' data:; style-src 'self'; base-uri 'none'; frame-ancestors 'none';"
  }
}
